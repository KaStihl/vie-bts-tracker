        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "ABOUT THIS DASHBOARD",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#5B6B7C",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0F2A4A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This dashboard tracks how low-cost carrier capacity has shifted between Vienna (VIE) and Bratislava (BTS) airports, following Austria's aviation tax and Wizz Air's exit from Vienna in March 2026.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "19pt",
                      "color": "#0F2A4A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0F2A4A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It is for anyone following the Vienna–Bratislava aviation story, and for a look at how the underlying data pipeline is built: a public case study in BI and data engineering with official sources, verified data and a transparent methodology.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#5B6B7C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0F2A4A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data comes from official press releases and annual reports of both airports, not from estimates. It is collected automatically and reviewed by hand where the sources are less structured.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#5B6B7C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0F2A4A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Airline-level data (who flies where) comes from real aircraft movements via the OpenSky Network. That history is still short and incomplete, so airline views are not published yet.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#5B6B7C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
