/// The two airports being compared. Related to monthly, annual and movement facts on the short code (VIE/BTS) so one Airport filter drives every page.
table Airport

	column 'Airport Code'
		dataType: string
		summarizeBy: none
		sourceColumn: [Airport Code]

	column ICAO
		dataType: string
		summarizeBy: none
		sourceColumn: [ICAO]

	column Airport
		dataType: string
		summarizeBy: none
		sourceColumn: [Airport]

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: [City]

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: [Country]

	partition Airport = calculated
		source =
				DATATABLE(
				    "Airport Code", STRING,
				    "ICAO", STRING,
				    "Airport", STRING,
				    "City", STRING,
				    "Country", STRING,
				    {
				        { "VIE", "LOWW", "Vienna International Airport", "Vienna", "Austria" },
				        { "BTS", "LZIB", "M. R. Štefánik Airport", "Bratislava", "Slovakia" }
				    }
				)

