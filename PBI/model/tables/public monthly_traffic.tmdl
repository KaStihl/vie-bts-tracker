	partition 'public monthly_traffic' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("aws-0-eu-central-1.pooler.supabase.com", "postgres"),
				    public_monthly_traffic = Source{[Schema="public",Item="monthly_traffic"]}[Data],
				    #"Renamed Columns" = Table.RenameColumns(public_monthly_traffic,{{"month", "month_number"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Month_helper", each if [month_number] = null then null else Date.ToText(#date(2000, [month_number], 1))),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"Month_helper", type date}}),
				    #"Inserted Month Name" = Table.AddColumn(#"Changed Type", "Month Name", each Date.MonthName([Month_helper]), type text)
				in
				    #"Inserted Month Name"

