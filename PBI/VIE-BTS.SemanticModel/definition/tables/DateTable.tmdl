/// Calendar spanning the monthly and movement data. Marked as date table.
table DateTable
	lineageTag: cfb45d06-fed2-4e3c-8c35-afbb1825d4c3
	dataCategory: Time

	column Date
		isKey
		formatString: m/d/yyyy
		lineageTag: e871627b-bacf-4f07-a87c-9ca96a30f74b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column Year
		formatString: 0
		lineageTag: 5e1c3fb6-c8ff-4e8b-80df-e5d9af30b9b0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		formatString: 0
		lineageTag: b5ff20ad-4a09-414f-95bb-a5a0b664b0fb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column 'Month Name'
		lineageTag: 83784fd9-4346-4027-ba2e-baa93cdd6c4b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Name]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	column Quarter
		lineageTag: 1f1e4a9b-403d-4950-b337-71c6968ccf0b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Week Number'
		formatString: 0
		lineageTag: 3c791f4b-f2b4-49e2-8b5c-56382844e537
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Number]

		annotation SummarizationSetBy = Automatic

	column 'Day Name'
		lineageTag: 7ab498da-ab6e-4934-a1b1-a17b9b32b165
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day Name]

		annotation SummarizationSetBy = Automatic

	column Year_Month
		lineageTag: f4630440-89c9-4131-8c5b-4d9be10b1bd7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year_Month]

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source = ```
				
				VAR MinDate = 
				    MIN(
				        MIN('public monthly_traffic'[Date]),
				        MIN('public carrier_movements'[Date])
				    )
				VAR MaxDate = 
				    MAX(
				        MAX('public monthly_traffic'[Date]),
				        MAX('public carrier_movements'[Date])
				    )
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Week Number", WEEKNUM([Date]),
				    "Day Name", FORMAT([Date], "dddd"),
				    "Year_Month",CONCATENATE((FORMAT([Date],"MMMM ")),YEAR([Date]))
				    )
				```

	annotation PBI_Id = 123615c5df8f448db823911ef4d531e2

