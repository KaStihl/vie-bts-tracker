/// Official monthly passenger counts from airport press releases (VIE) and press releases / annual report (BTS).
table 'public monthly_traffic'
	lineageTag: 5c067abb-4acf-49c0-be8c-98b71d7eb61c

	column id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5c4b4ade-a008-4f8e-91a3-96b4616d44d1
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	column airport_code
		dataType: string
		lineageTag: 922a247f-ca1a-4ee4-ac12-90b7ed10bc7d
		summarizeBy: none
		sourceColumn: airport_code

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 77de17a4-765d-429c-b187-362e19745db5
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: ebc8e27d-e8bb-4bc5-8daf-d41567fe9ea1
		summarizeBy: none
		sourceColumn: month_number

		annotation SummarizationSetBy = Automatic

	column passengers
		dataType: int64
		formatString: #,0
		lineageTag: 32229544-a078-4525-a8a8-74af6d24fa1e
		summarizeBy: sum
		sourceColumn: passengers

		annotation SummarizationSetBy = Automatic

	/// Year-over-year change as published, in percent units (-5.9 means -5.9 %). Use the [YoY Change PAX %] measure for display.
	column yoy_change_pct
		dataType: double
		formatString: 0.0"%"
		lineageTag: babc08e7-2ba2-49e0-8514-92d2e5f6ac10
		summarizeBy: none
		sourceColumn: yoy_change_pct

		annotation SummarizationSetBy = Automatic

	column group_passengers
		dataType: int64
		formatString: #,0
		lineageTag: 48db1787-176e-4a50-8198-81f3c34faee3
		summarizeBy: sum
		sourceColumn: group_passengers

		annotation SummarizationSetBy = Automatic

	column group_yoy_pct
		dataType: double
		formatString: 0.0"%"
		lineageTag: d4fa21fa-6a91-43a9-a568-9108a7c82db8
		summarizeBy: none
		sourceColumn: group_yoy_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column verified
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4a521018-a3a5-4f86-a5a0-c60ec33f0895
		summarizeBy: none
		sourceColumn: verified

		annotation SummarizationSetBy = Automatic

	column source_url
		dataType: string
		isHidden
		lineageTag: f5cca954-c2b7-43ca-8ceb-0649c62e7df1
		summarizeBy: none
		sourceColumn: source_url

		annotation SummarizationSetBy = Automatic

	column raw_text
		dataType: string
		isHidden
		lineageTag: 3210c0cf-32ac-46f0-b5a5-f9455c0e8221
		summarizeBy: none
		sourceColumn: raw_text

		annotation SummarizationSetBy = Automatic

	column scraped_at
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 716bcaaf-8078-4d1f-96d0-b967936aa1c3
		summarizeBy: none
		sourceColumn: scraped_at

		annotation SummarizationSetBy = Automatic

	column Month_helper
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 3f97330f-1184-4536-a723-0990589b8c42
		summarizeBy: none
		sourceColumn: Month_helper

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Month Name'
		dataType: string
		lineageTag: 23a67b37-495e-4a7f-ad01-8323ce86f108
		summarizeBy: none
		sourceColumn: Month Name

		annotation SummarizationSetBy = Automatic

	/// First day of the reported month (blank for unresolved rows). Axis labels read like Jan 2026.
	column Date = IF(ISBLANK('public monthly_traffic'[month_number]), BLANK(), DATE('public monthly_traffic'[year], 'public monthly_traffic'[month_number], 1))
		formatString: mmm yyyy
		lineageTag: 1f43e858-053f-4b2a-ab25-5c41e7251438
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column source
		dataType: string
		lineageTag: 92751d49-8dcf-424e-850c-7590d6d25f31
		summarizeBy: none
		sourceColumn: source

		annotation SummarizationSetBy = Automatic

	partition 'public monthly_traffic' = m
		mode: import
		source =
				let
				    ToUtc = (t as any) as nullable datetime =>
				        if t = null then null else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(t), 0)),

				    Source = fnSupabase("monthly_traffic", "airport_code,year,month", null),
				    Typed = Table.TransformColumnTypes(
				        Source,
				        {{"id", Int64.Type}, {"airport_code", type text}, {"year", Int64.Type}, {"month", Int64.Type},
				         {"passengers", Int64.Type}, {"yoy_change_pct", type number}, {"group_passengers", Int64.Type},
				         {"group_yoy_pct", type number}, {"verified", Int64.Type}, {"source_url", type text}, {"raw_text", type text}},
				        "en-US"
				    ),
				    Published = Table.SelectRows(Typed, each [month] <> null and [verified] = 1),
				    Scraped = Table.TransformColumns(Published, {{"scraped_at", ToUtc, type datetime}}),
				    Renamed = Table.RenameColumns(Scraped, {{"month", "month_number"}}),
				    Official = Table.AddColumn(Renamed, "source", each "Press release", type text),

				    EuroRaw = try fnSupabase("eurostat_monthly", "airport_code,year,month", null)
				        otherwise #table({"airport_code", "year", "month", "passengers", "scraped_at"}, {}),
				    EuroTyped = Table.TransformColumnTypes(
				        EuroRaw,
				        {{"airport_code", type text}, {"year", Int64.Type}, {"month", Int64.Type}, {"passengers", Int64.Type}},
				        "en-US"
				    ),
				    EuroPrev = Table.RenameColumns(
				        Table.TransformColumns(
				            Table.SelectColumns(EuroTyped, {"airport_code", "year", "month", "passengers"}),
				            {{"year", each _ + 1, Int64.Type}}
				        ),
				        {{"passengers", "prev_passengers"}}
				    ),
				    EuroJoined = Table.ExpandTableColumn(
				        Table.NestedJoin(EuroTyped, {"airport_code", "year", "month"}, EuroPrev, {"airport_code", "year", "month"}, "p", JoinKind.LeftOuter),
				        "p", {"prev_passengers"}
				    ),
				    EuroYoy = Table.AddColumn(
				        EuroJoined, "yoy_change_pct",
				        each if [prev_passengers] = null or [prev_passengers] = 0 then null else Number.Round(([passengers] / [prev_passengers] - 1) * 100, 1),
				        type number
				    ),
				    EuroRenamed = Table.RenameColumns(EuroYoy, {{"month", "month_number"}}),
				    EuroGaps = Table.RemoveColumns(
				        Table.NestedJoin(EuroRenamed, {"airport_code", "year", "month_number"}, Official, {"airport_code", "year", "month_number"}, "o", JoinKind.LeftAnti),
				        {"prev_passengers"}
				    ),
				    EuroScraped = Table.TransformColumns(EuroGaps, {{"scraped_at", ToUtc, type datetime}}),
				    EuroId = Table.AddColumn(EuroScraped, "id", each null, Int64.Type),
				    EuroGroupPax = Table.AddColumn(EuroId, "group_passengers", each null, Int64.Type),
				    EuroGroupYoy = Table.AddColumn(EuroGroupPax, "group_yoy_pct", each null, type number),
				    EuroVerified = Table.AddColumn(EuroGroupYoy, "verified", each 1, Int64.Type),
				    EuroUrl = Table.AddColumn(EuroVerified, "source_url", each "https://ec.europa.eu/eurostat/databrowser/view/avia_paoa/", type text),
				    EuroText = Table.AddColumn(EuroUrl, "raw_text", each "Eurostat avia_paoa: passengers on board (month not published by the airport)", type text),
				    Euro = Table.AddColumn(EuroText, "source", each "Eurostat", type text),

				    Combined = Table.Combine({Official, Euro}),
				    MonthHelper = Table.AddColumn(Combined, "Month_helper", each #date([year], [month_number], 1), type date),
				    MonthName = Table.AddColumn(MonthHelper, "Month Name", each Date.MonthName([Month_helper], "en-US"), type text)
				in
				    MonthName

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

