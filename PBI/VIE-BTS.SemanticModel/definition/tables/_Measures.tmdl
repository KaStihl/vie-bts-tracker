/// Measure container. NOTE: the name is a typo of 'Measures' but report visuals reference it - rename it in Power BI Desktop (Model view), which updates visuals automatically.
table _Measures
	lineageTag: 5980967d-8e83-4b67-b497-ce932a73b583

	measure 'Total Movements' = COUNTROWS('public carrier_movements')
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: 9d78bf79-9b05-4137-b4cf-77e9c4a29f85

	measure 'Departures Only' = ```
			
			CALCULATE([Total Movements], 'public carrier_movements'[direction] = "departure")
			
			```
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: e78dd81e-2323-4ac6-ad1c-64fa1c350ced

	measure 'Movements Ryanair' =
			
			CALCULATE([Total Movements], 'public carrier_movements'[airline] = "Ryanair")
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: 63151716-1315-4968-92ca-3fe0a91c94e8

	measure 'Movements Wizz Air' =
			
			CALCULATE([Total Movements], 'public carrier_movements'[airline] = "Wizz Air")
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: d41ca6e3-e9ec-4b9d-900f-4b1faac46f02

	measure 'Movements Austrian' =
			
			CALCULATE([Total Movements], 'public carrier_movements'[airline] = "Austrian Airlines")
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: d29e607b-5cc6-40ee-9225-b6ec81b8a29e

	measure 'Movements Other' =
			
			CALCULATE([Total Movements], 'public carrier_movements'[airline] = "OTHER")
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: e3dff957-c22e-4079-b879-cb498ed13886

	measure '% Share of Movements' =
			
			DIVIDE([Total Movements], CALCULATE([Total Movements], ALL('public carrier_movements'[airline])))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: carrier_movements
		lineageTag: 49f0d405-ff54-4fde-bc5b-416cbd05dd04

	measure 'LCC Share (Ryanair+Wizz)' =
			
			DIVIDE([Movements Ryanair] + [Movements Wizz Air], [Total Movements])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: carrier_movements
		lineageTag: d5010612-4836-4b66-9054-5a12593ecc61

	measure 'Days Tracked' =
			
			DATEDIFF(MIN('public carrier_movements'[movement_time]), MAX('public carrier_movements'[movement_time]), DAY) + 1
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: 9fa239f8-d107-4275-b97a-6449d8b4beb8

	measure 'Movements MTD' = TOTALMTD([Total Movements], DateTable[Date])
		formatString: 0
		displayFolder: time_intelligence
		lineageTag: 88c47022-e56b-4c5d-83a1-9f57c9cfc019

	measure 'Movements Previous Month' =
			
			CALCULATE([Total Movements], DATEADD(DateTable[Date], -1, MONTH))
		formatString: 0
		displayFolder: time_intelligence
		lineageTag: f026533f-3de6-4d3c-9bdb-4fd0abec4e1b

	measure 'MoM %' =
			
			DIVIDE([Total Movements] - [Movements Previous Month], [Movements Previous Month])
		displayFolder: time_intelligence
		lineageTag: 2bc0890a-417c-42a7-8786-0449592a562c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Movements Previous Year' =
			
			CALCULATE([Total Movements], SAMEPERIODLASTYEAR(DateTable[Date]))
		formatString: 0
		displayFolder: time_intelligence
		lineageTag: 7803a793-98df-4223-93dc-1d60b85025ce

	measure 'YoY %' =
			
			DIVIDE([Total Movements] - [Movements Previous Year], [Movements Previous Year])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: time_intelligence
		lineageTag: e3c4b04a-d3b3-4ac5-9885-eb372a66f9e6

	measure 'Movements Previous Week' =
			
			CALCULATE([Total Movements], DATEADD(DateTable[Date], -7, DAY))
		formatString: 0
		displayFolder: time_intelligence
		lineageTag: 310c5c9c-5534-4db6-a6d9-b807201aa872

	/// Week-over-week change in captured movements. (Was divided by 100 a second time, so it showed 1/100 of the real value.)
	measure 'WoW %' = DIVIDE([Total Movements] - [Movements Previous Week], [Movements Previous Week])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: time_intelligence
		lineageTag: 83427def-1eab-4dd1-90e7-499eaffbd3dd

	measure 'Rolling 7-Day Avg' =
			
			AVERAGEX(
			    DATESINPERIOD(DateTable[Date], MAX(DateTable[Date]), -7, DAY),
			    [Total Movements]
			)
		formatString: 0
		displayFolder: time_intelligence
		lineageTag: f6330809-eeda-411c-9f23-6a3d9f6e9280

	measure 'Day over Day %' =
			
			VAR Today = CALCULATE([Total Movements], DateTable[Date] = MAX(DateTable[Date]))
			VAR Yesterday = CALCULATE([Total Movements], DateTable[Date] = MAX(DateTable[Date])-1)
			RETURN DIVIDE(Today - Yesterday, Yesterday)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: time_intelligence
		lineageTag: ad424647-b462-4843-8411-4149d2b289f0

	measure 'BTS Passengers Latest Year' =
			
			CALCULATE(SUM('public annual_traffic'[total]), 'public annual_traffic'[airport_code]="BTS", 'public annual_traffic'[year]=MAX('public annual_traffic'[year]))
		formatString: 0
		displayFolder: annual_traffic
		lineageTag: 35901212-47b4-4e5a-8efe-53a939d11cec

	measure 'VIE Latest Passengers' =
			
			VAR LatestVieDate = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code]="VIE")
			RETURN
			CALCULATE(
			    SUM('public monthly_traffic'[passengers]),
			    'public monthly_traffic'[airport_code] = "VIE",
			    'public monthly_traffic'[Date] = LatestVieDate
			)
		formatString: 0
		displayFolder: monthly_traffic
		lineageTag: ad2cab73-c2b6-4f63-ad95-91ff3f0e9df8

	measure 'VIE Passengers Latest Year' =
			
			CALCULATE(SUM('public annual_traffic'[total]), 'public annual_traffic'[airport_code]="VIE", 'public annual_traffic'[year]=MAX('public annual_traffic'[year]))
		formatString: 0
		displayFolder: annual_traffic
		lineageTag: 6c2fbc50-249f-46ae-9039-86b4f80bdf76

	/// Growth gap BTS minus VIE in PERCENTAGE POINTS (not %), same month for both airports. Signed: no longer hides the case where Vienna outgrows Bratislava (was ABS()). Name kept because report visuals reference it.
	measure 'Rozdiel v trende' =
			-- BTS growth minus VIE growth, in percentage points, for the newest month BOTH airports have.
			VAR _vie = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE", NOT ISBLANK('public monthly_traffic'[yoy_change_pct]))
			VAR _bts = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS", NOT ISBLANK('public monthly_traffic'[yoy_change_pct]))
			VAR _common = MIN(_vie, _bts)
			VAR _vieYoY = CALCULATE(SUM('public monthly_traffic'[yoy_change_pct]), 'public monthly_traffic'[airport_code] = "VIE", 'public monthly_traffic'[Date] = _common)
			VAR _btsYoY = CALCULATE(SUM('public monthly_traffic'[yoy_change_pct]), 'public monthly_traffic'[airport_code] = "BTS", 'public monthly_traffic'[Date] = _common)
			RETURN IF(NOT ISBLANK(_vieYoY) && NOT ISBLANK(_btsYoY), _btsYoY - _vieYoY)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: monthly_traffic
		lineageTag: 623d2603-f276-4eed-9005-c50fca020c85

	measure 'BTS Latest Passengers' =
			
			VAR LatestVieDate = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code]="BTS")
			RETURN
			CALCULATE(
			    SUM('public monthly_traffic'[passengers]),
			    'public monthly_traffic'[airport_code] = "BTS",
			    'public monthly_traffic'[Date] = LatestVieDate
			)
		formatString: 0
		displayFolder: monthly_traffic
		lineageTag: e84d6160-69c3-4cfc-9bd9-9192107dabec

	measure 'VIE Latest YoY' =
			VAR _latest = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE")
			RETURN CALCULATE([YoY Change PAX %], 'public monthly_traffic'[airport_code] = "VIE", 'public monthly_traffic'[Date] = _latest)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: monthly_traffic
		lineageTag: e870357f-0002-41b9-90c7-6072e550ec8b

	measure 'BTS Latest YoY' =
			VAR _latest = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS")
			RETURN CALCULATE([YoY Change PAX %], 'public monthly_traffic'[airport_code] = "BTS", 'public monthly_traffic'[Date] = _latest)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: monthly_traffic
		lineageTag: a58b52b9-2c9f-4928-892f-01dfb9976764

	/// Year-over-year passenger change for one month. Uses the % published by the airport; where the release gave none (BTS 2019-2024, most VIE 2023 headlines) it is computed from the same month a year earlier. Never sums percentages.
	measure 'YoY Change PAX %' =
			VAR _rows = COUNTROWS('public monthly_traffic')
			VAR _reported = SUM('public monthly_traffic'[yoy_change_pct])
			VAR _current = SUM('public monthly_traffic'[passengers])
			VAR _month = SELECTEDVALUE('public monthly_traffic'[Date])
			VAR _lastYear =
			    IF(
			        NOT ISBLANK(_month),
			        CALCULATE(
			            SUM('public monthly_traffic'[passengers]),
			            REMOVEFILTERS(DateTable),
			            REMOVEFILTERS('public monthly_traffic'[Date]),
			            'public monthly_traffic'[Date] = EDATE(_month, -12)
			        )
			    )
			RETURN
			    IF(
			        _rows = 1 && NOT ISBLANK(_reported),
			        _reported / 100,
			        IF(NOT ISBLANK(_current) && _lastYear > 0, DIVIDE(_current - _lastYear, _lastYear))
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: monthly_traffic
		lineageTag: e20516bc-e808-4014-a7ad-a02ee4bcea89

	measure 'yoy_change color' =
			
			VAR _Value = [YoY Change PAX %]
			VAR _Airport = SELECTEDVALUE('public monthly_traffic'[airport_code])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Value), BLANK(),
			        _Value < 0, "#E63946",
			        _Airport = "BTS", "#0F2A4A",
			        _Airport = "VIE", "#2CA6A4",
			        "#2CA6A4"
			    )
		displayFolder: monthly_traffic
		lineageTag: 9d98a65c-57b4-484f-8a21-389ed2d8eb1f

	measure 'Total Movements BTS' =
			
			CALCULATE([Total Movements], 'public carrier_movements'[airport_code] = "BTS")
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: 44d3c0b5-ecd7-4971-a870-39d6b5711656

	measure 'Total Movements VIE' =
			
			CALCULATE([Total Movements], 'public carrier_movements'[airport_code] = "VIE")
		formatString: 0
		displayFolder: carrier_movements
		lineageTag: 33f8b3fc-0464-48a6-90b4-f63a3bc94dbd

	/// Month of the newest Vienna figure - show it under the card so readers know which month is compared.
	measure 'VIE Latest Month' =
			VAR _latest = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE")
			RETURN FORMAT(_latest, "mmm yyyy")
		displayFolder: monthly_traffic
		lineageTag: c99e4a4f-9b4d-4e20-81e0-e3f105b030d8

	/// Month of the newest Bratislava figure.
	measure 'BTS Latest Month' =
			VAR _latest = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS")
			RETURN FORMAT(_latest, "mmm yyyy")
		displayFolder: monthly_traffic
		lineageTag: a20cb7e7-3b50-46cd-9708-56254ab5f23b

	/// Distinct date+hour slots (05:00-21:59, assumed UTC) that contain at least one captured departure.
	measure 'Departure Hours With Data' =
			COUNTROWS(
			    SUMMARIZE(
			        FILTER(
			            'public carrier_movements',
			            'public carrier_movements'[direction] = "departure"
			                && 'public carrier_movements'[Hour] >= 5
			                && 'public carrier_movements'[Hour] <= 21
			        ),
			        'public carrier_movements'[Date],
			        'public carrier_movements'[Hour]
			    )
			)
		formatString: 0
		displayFolder: data_quality
		lineageTag: f5e13720-5a07-4aea-b1f2-a1915869e147

	/// Share of daytime hours (17 per day) with at least one captured departure. Far below 100% means the hourly OpenSky job missed runs (movements in the gaps are lost for good), so absolute movement counts are UNDERCOUNTED; shares between airlines are still usable.
	measure 'Capture Coverage %' =
			VAR _days = DATEDIFF(MIN('public carrier_movements'[Date]), MAX('public carrier_movements'[Date]), DAY) + 1
			RETURN DIVIDE([Departure Hours With Data], _days * 17)
		formatString: 0%
		displayFolder: data_quality
		lineageTag: 6d1d10f2-9ede-4097-afb5-11b38db5c96d

	/// Timestamp of the newest captured movement - tells readers how fresh the carrier data is.
	measure 'Last Movement Captured' = MAX('public carrier_movements'[movement_time])
		formatString: dd mmm yyyy hh:mm
		displayFolder: data_quality
		lineageTag: 4130e412-30c6-415e-a5ff-1b617ba4db8b

	/// One-line takeaway shown under the page title.
	measure Headline =
			VAR _bts = [BTS Latest YoY]
			VAR _vie = [VIE Latest YoY]
			RETURN
			"Bratislava " & FORMAT(_bts, "+0%;-0%") & "   ·   Vienna " & FORMAT(_vie, "+0.0%;-0.0%") & "   year over year (latest month)"
		displayFolder: report
		lineageTag: 1ecf024e-a05e-4565-8d9c-90d462f099b8

	/// Red when Vienna shrinks, green when it grows.
	measure 'VIE YoY Color' = IF([VIE Latest YoY] < 0, "#FF7B7B", "#3DDC97")
		displayFolder: report
		lineageTag: 53fbd417-1da6-4aec-979e-c9cfa7061180

	/// Red when Bratislava shrinks, green when it grows.
	measure 'BTS YoY Color' = IF([BTS Latest YoY] < 0, "#FF7B7B", "#3DDC97")
		displayFolder: report
		lineageTag: 5ce29685-d0e8-4bdf-b88c-a6efa2a439bc

	/// Footer stamp: when the model was last refreshed, in one piece.
	measure 'Refresh Label' = "Last refresh (UTC):  " & FORMAT(MAX('Query'[Column1]), "d mmm yyyy  ·  HH:mm")
		displayFolder: report
		lineageTag: 5f4f7eb9-4a24-4647-a0c9-160a9c1fe085

	/// How many times larger Vienna is than Bratislava in the latest month.
	measure 'Size Ratio' = "Vienna is " & FORMAT(DIVIDE([VIE Latest Passengers], [BTS Latest Passengers]), "0.0") & "x larger"
		displayFolder: report
		lineageTag: 5e322a5e-7cb5-47e1-beb5-066b66c660ba

	/// Vienna: passengers in the previous release (the newest month before the latest one that was published).
	measure 'VIE Prev Passengers' =
			VAR _l = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE")
			VAR _p = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE", 'public monthly_traffic'[Date] < _l)
			RETURN CALCULATE(SUM('public monthly_traffic'[passengers]), 'public monthly_traffic'[airport_code] = "VIE", 'public monthly_traffic'[Date] = _p)
		formatString: 0
		displayFolder: report
		lineageTag: 214fea28-f57b-4524-869d-030c3bb052a2

	/// Vienna: month of the previous release.
	measure 'VIE Prev Month' =
			VAR _l = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE")
			VAR _p = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "VIE", 'public monthly_traffic'[Date] < _l)
			RETURN FORMAT(_p, "mmm yyyy")
		displayFolder: report
		lineageTag: 18720fcc-9217-40e6-8d63-3e0fe9ee3ed1

	/// Vienna: change versus the previous release.
	measure 'VIE MoM' = DIVIDE([VIE Latest Passengers] - [VIE Prev Passengers], [VIE Prev Passengers])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: report
		lineageTag: c29c5dcf-4879-4f97-b267-886beb8a122b

	/// Red when down, green when up (text colour, AA contrast on the card).
	measure 'VIE MoM Color' = IF([VIE MoM] < 0, "#FF7B7B", "#3DDC97")
		displayFolder: report
		lineageTag: 6eb926cb-32fd-40f1-bd9e-bdffe9be2ea9

	/// Bratislava: passengers in the previous release (the newest month before the latest one that was published).
	measure 'BTS Prev Passengers' =
			VAR _l = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS")
			VAR _p = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS", 'public monthly_traffic'[Date] < _l)
			RETURN CALCULATE(SUM('public monthly_traffic'[passengers]), 'public monthly_traffic'[airport_code] = "BTS", 'public monthly_traffic'[Date] = _p)
		formatString: 0
		displayFolder: report
		lineageTag: 986a3905-9807-4cdc-b9b7-5670af3eab0d

	/// Bratislava: month of the previous release.
	measure 'BTS Prev Month' =
			VAR _l = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS")
			VAR _p = CALCULATE(MAX('public monthly_traffic'[Date]), 'public monthly_traffic'[airport_code] = "BTS", 'public monthly_traffic'[Date] < _l)
			RETURN FORMAT(_p, "mmm yyyy")
		displayFolder: report
		lineageTag: 27a7132b-8f59-49a6-a65d-3fed4b139a3b

	/// Bratislava: change versus the previous release.
	measure 'BTS MoM' = DIVIDE([BTS Latest Passengers] - [BTS Prev Passengers], [BTS Prev Passengers])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: report
		lineageTag: d6f7b31a-0bcb-408a-a109-807a56dc52cc

	/// Red when down, green when up (text colour, AA contrast on the card).
	measure 'BTS MoM Color' = IF([BTS MoM] < 0, "#FF7B7B", "#3DDC97")
		displayFolder: report
		lineageTag: 85e76ac3-39ba-4921-bbb9-b4546010327d

	/// Vienna: year-over-year change per month, still filtered by the Airport slicer (one measure per airport so each can be coloured by sign).
	measure 'VIE YoY' = CALCULATE([YoY Change PAX %], KEEPFILTERS('public monthly_traffic'[airport_code] = "VIE"))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: report
		lineageTag: 36752419-345a-4a37-85f9-b2b9deb6440b

	/// Bratislava: year-over-year change per month, still filtered by the Airport slicer (one measure per airport so each can be coloured by sign).
	measure 'BTS YoY' = CALCULATE([YoY Change PAX %], KEEPFILTERS('public monthly_traffic'[airport_code] = "BTS"))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: report
		lineageTag: 42d78d75-72e1-4502-b250-c6eb75abac4f

	/// Vienna: the growth months (blank otherwise), so growth and decline can be coloured differently.
	measure 'VIE YoY Up' =
			VAR _v = [VIE YoY]
			RETURN IF(_v >= 0, _v)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: report
		lineageTag: 76f04f14-ebaa-48d2-b5e4-eb0d42b5830f

	/// Vienna: the decline months (blank otherwise).
	measure 'VIE YoY Down' =
			VAR _v = [VIE YoY]
			RETURN IF(_v < 0, _v)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: report
		lineageTag: 0f5a83fd-3f71-4283-93eb-c20d0389d676

	/// Bratislava: the growth months (blank otherwise), so growth and decline can be coloured differently.
	measure 'BTS YoY Up' =
			VAR _v = [BTS YoY]
			RETURN IF(_v >= 0, _v)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: report
		lineageTag: 3fac862e-2ff6-4744-b06f-523c111c5f6f

	/// Bratislava: the decline months (blank otherwise).
	measure 'BTS YoY Down' =
			VAR _v = [BTS YoY]
			RETURN IF(_v < 0, _v)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: report
		lineageTag: ec8666aa-4674-460b-a253-77742b562d49

	column 1
		dataType: string
		isHidden
		lineageTag: d5184072-c6ce-4ee1-b0f6-5fff4b1199ee
		summarizeBy: none
		sourceColumn: 1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"1" = _t])
				in
				  Source

	changedProperty = Name

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

