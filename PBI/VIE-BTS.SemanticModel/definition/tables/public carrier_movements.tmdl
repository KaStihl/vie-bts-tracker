	partition 'public carrier_movements' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("aws-0-eu-central-1.pooler.supabase.com", "postgres"),
				  #"Navigation 1" = Source{[Schema = "public", Item = "carrier_movements"]}[Data],
				    #"Inserted Month Name" = Table.AddColumn(#"Navigation 1", "Month Name", each Date.MonthName([movement_time]), type text),
				    #"Inserted Month" = Table.AddColumn(#"Inserted Month Name", "Month", each Date.Month([movement_time]), Int64.Type),
				    #"Inserted Year" = Table.AddColumn(#"Inserted Month", "Year", each Date.Year([movement_time]), Int64.Type),
				    #"Inserted Quarter" = Table.AddColumn(#"Inserted Year", "Quarter", each Date.QuarterOfYear([movement_time]), Int64.Type),
				    #"Inserted Week of Month" = Table.AddColumn(#"Inserted Quarter", "Week of Month", each Date.WeekOfMonth([movement_time]), Int64.Type),
				    #"Inserted Day Name" = Table.AddColumn(#"Inserted Week of Month", "Day Name", each Date.DayOfWeekName([movement_time]), type text),
				    #"Inserted Day" = Table.AddColumn(#"Inserted Day Name", "Day", each Date.Day([movement_time]), Int64.Type),
				    #"Inserted Hour" = Table.AddColumn(#"Inserted Day", "Hour", each Time.Hour([movement_time]), Int64.Type),
				    #"Inserted Minute" = Table.AddColumn(#"Inserted Hour", "Minute", each Time.Minute([movement_time]), Int64.Type),
				    #"Inserted Time" = Table.AddColumn(#"Inserted Minute", "Time", each DateTime.Time([movement_time]), type time),
				    #"Inserted Day of Week" = Table.AddColumn(#"Inserted Time", "Day of Week", each Date.DayOfWeek([movement_time]), Int64.Type)
				in
				  #"Inserted Day of Week"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

